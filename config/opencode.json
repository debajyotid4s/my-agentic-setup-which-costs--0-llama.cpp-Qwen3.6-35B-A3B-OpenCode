{
  "$schema": "https://opencode.ai/config.json",

  "model": "local/qwen3.6-35b-a3b",
  "small_model": "opencode/deepseek-v4.1-flash-free",

  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 49152
  },

  "agent": {
    "build":      { "temperature": 0.6, "top_p": 0.95 },
    "plan":       { "temperature": 0.6, "top_p": 0.95 },
    "general":    { "temperature": 0.6, "top_p": 0.95 },
    "explore":    { "temperature": 0.6, "top_p": 0.95 },
    "compaction": { "temperature": 0.6, "top_p": 0.95 }
  },

  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local GPU)",

      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": false,
        "chunkTimeout": false
      },

      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (256K)",

          "tool_call": true,
          "reasoning": true,
          "temperature": true,

          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          }
        }
      }
    }
  },

  "permissions": {
    "rules": [
      {
        "match": { "command": "rm", "shell": true },
        "mode": "ask"
      },
      {
        "match": { "command": "rm -rf", "shell": true },
        "mode": "deny"
      },
      {
        "match": { "command": "git push", "shell": true },
        "mode": "ask"
      },
      {
        "match": { "command": "sudo", "shell": true },
        "mode": "ask"
      },
      {
        "match": { "command": "mkfs", "shell": true },
        "mode": "deny"
      },
      {
        "match": { "command": "dd if=", "shell": true },
        "mode": "deny"
      }
    ]
  },

  "_small_model_note": "WARNING: small_model uses a remote free tier. Titles are sent to a third party. If the model ID rotates out, OpenCode may fall back to your single local slot and evict the cache. Consider setting small_model to your local model or disabling it."
}
