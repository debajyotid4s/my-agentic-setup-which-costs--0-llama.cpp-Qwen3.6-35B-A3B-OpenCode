{
  "$schema": "https://opencode.ai/config.json",

  "model": "v100/ornith-1.5-35b-a3b-iq4-xs",
  "small_model": "opencode/deepseek-v4.1-flash-free",

  "instructions": [".agent/HANDOFF.md"],

  "compaction": {
    "auto": false,
    "keep": { "tokens": 15000 },
    "buffer": "20%"
  },

  "experimental": {
    "todo": true,
    "background_compaction": false
  },

  "permissions": [
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "dd if=*", "effect": "deny" }
  ],

  "providers": {
    "v100": {
      "name": "llama.cpp (Tesla V100)",
      "package": "@opencode/ai/providers/openai-compatible",

      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": false,
        "chunkTimeout": false
      },

      "models": {
        "ornith-1.5-35b-a3b-iq4-xs": {
          "name": "Ornith-1.5 35B-A3B (IQ4_XS, 256K)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "toggle": true },
            "temperature": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          }
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (IQ4_XS, 256K)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true, "toggle": true },
            "temperature": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          }
        }
      }
    }
  }
}
